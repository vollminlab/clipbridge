#!/bin/sh
# clipbridge-recv - read a PNG on stdin, store it, print its absolute path.
#
# Storage only. Targeting is the laptop's job: focus is knowable there and
# unknowable here. See docs/superpowers/specs/clipbridge-design.md.
#
# Exit codes: 0 ok | 3 bad input | 5 cannot write
set -u

CLIP_DIR="${CLIPBRIDGE_DIR:-$HOME/.clipbridge}"
KEEP_COUNT="${CLIPBRIDGE_KEEP_COUNT:-50}"
KEEP_DAYS="${CLIPBRIDGE_KEEP_DAYS:-7}"

die() { echo "clipbridge: $1" >&2; exit "$2"; }

mkdir -p "$CLIP_DIR" || die "cannot create $CLIP_DIR" 5

# Unconditional, every run: this directory holds private screenshots, so
# owner-only (0700) must self-heal from whatever a prior run or a stray
# chmod -R left it as, rather than being trusted as a one-time setup step.
# The kill switch for this tool is the forced-command entry in
# authorized_keys, not filesystem permissions on its own storage directory.
chmod 700 "$CLIP_DIR" || die "cannot chmod $CLIP_DIR" 5

# Defense-in-depth, not a tested guard: under DAC alone this is unreachable
# here. mkdir -p and chmod 700 above already succeeded, which guarantees
# owner-write for this same process; a read-only remount or immutable
# directory would fail the chmod itself first. The only way this fires is a
# MAC framework (SELinux) permitting setattr but denying write -- not
# applicable on this Ubuntu 24.04 box. Kept as a belt-and-suspenders check,
# not evidence of coverage.
[ -w "$CLIP_DIR" ] || die "cannot write $CLIP_DIR" 5

tmp=$(mktemp "$CLIP_DIR/.incoming.XXXXXX") || die "cannot create temp file in $CLIP_DIR" 5
trap 'rm -f "$tmp"' EXIT INT TERM

# Write stdin out first, then inspect the file. Peeking at the stream would
# consume the bytes we still need.
cat > "$tmp" || die "cannot write $tmp" 5

[ -s "$tmp" ] || die "empty input" 3

magic=$(od -An -tx1 -N8 "$tmp" | tr -d ' \n')
[ "$magic" = "89504e470d0a1a0a" ] || die "not a PNG (magic=$magic)" 3

base=$(date +%Y%m%d-%H%M%S)
path="$CLIP_DIR/$base.png"
n=2
# Assumes a single-invocation caller (one person, one hotkey at a time) --
# not safe under concurrent execution. The check-then-mv here is TOCTOU: two
# truly concurrent invocations could both resolve the same free path, and
# the later mv would overwrite the earlier one. No retry/lock is added for
# this because there is no concurrent server-side request path to defend.
while [ -e "$path" ]; do
    path="$CLIP_DIR/$base-$n.png"
    n=$((n + 1))
done

chmod 600 "$tmp" || die "cannot chmod incoming file" 5
mv "$tmp" "$path" || die "cannot move incoming file into place" 5
trap - EXIT INT TERM

# Both bounds, every run. A burst should not be retained for close to a
# week, and a single screenshot should not live forever.
#
# Assumes only this script ever writes into CLIP_DIR, same as the TOCTOU
# note above. ls -1t emits one filename per line, so a name containing an
# embedded newline splits into fragments here and the later `rm -f`
# silently no-ops on each fragment -- the file survives pruning. Not
# reachable through the wire protocol (stdin carries a PNG, never a
# filename) and this script only ever generates names matching
# [0-9]{8}-[0-9]{6}(-[0-9]+)?.png, so this only matters if something other
# than this script drops an oddly-named file into CLIP_DIR. Spaces and
# backslashes are handled correctly by `IFS= read -r`; newlines are not.
ls -1t "$CLIP_DIR"/*.png 2>/dev/null | tail -n "+$((KEEP_COUNT + 1))" | while IFS= read -r old; do
    rm -f "$old"
done
# -exec ... \; rather than + : busybox find does not reliably support +.
# This path does not share the newline-splitting flaw above -- find -exec
# passes each match to rm intact, one invocation per file, regardless of
# what characters the name contains.
#
# -mtime +N matches files whose age is at least N+1 whole days: find
# truncates each file's age to an integer day count before comparing, so
# a file has to cross that next whole-day boundary to match. With
# KEEP_DAYS=7 a file 7.99 days old still survives and one 8.01 days old
# gets pruned -- so KEEP_DAYS=7 actually retains for close to 8 days, not 7.
find "$CLIP_DIR" -maxdepth 1 -name '*.png' -mtime "+$KEEP_DAYS" -exec rm -f {} \; 2>/dev/null

echo "$path"
